{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Bot Web Challenge Detector Output",
  "description": "Structured bot detection output from the bot-web-challenge detector.",
  "type": "object",
  "required": ["detector", "timestamp", "userAgent", "url", "tests", "findings", "scoredArtifacts", "summary"],
  "properties": {
    "detector": {
      "type": "object",
      "required": ["name", "version", "schemaVersion", "buildTime", "gitCommit", "gitBranch"],
      "properties": {
        "name": { "type": "string" },
        "version": { "type": "string" },
        "schemaVersion": { "type": "integer", "minimum": 3 },
        "buildTime": { "type": "string", "format": "date-time" },
        "gitCommit": { "type": "string" },
        "gitBranch": { "type": "string" }
      }
    },
    "timestamp": { "type": "string", "format": "date-time" },
    "userAgent": { "type": "string" },
    "url": { "type": "string", "format": "uri" },
    "tests": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/definitions/normalizedTestResult"
      }
    },
    "findings": {
      "type": "array",
      "items": { "$ref": "#/definitions/detectionResult" }
    },
    "scoredArtifacts": {
      "type": "array",
      "items": { "$ref": "#/definitions/scoredArtifact" }
    },
    "trackingStats": { "type": ["object", "null"] },
    "summary": { "$ref": "#/definitions/summary" }
  },
  "definitions": {
    "detectionResult": {
      "type": "object",
      "required": ["status", "severity", "category", "artifactId", "context", "reason", "description"],
      "properties": {
        "status": { "type": "string", "enum": ["passed", "finding", "inconclusive", "not-applicable"] },
        "severity": { "type": "string", "enum": ["info", "weak", "medium", "strong", "hard"] },
        "category": { "type": "string" },
        "artifactId": { "type": "string" },
        "context": { "type": "string", "enum": ["main", "iframe", "same-origin-iframe", "sandboxed-iframe", "blob-iframe", "worker", "shared-worker", "offscreen-canvas", "interaction"] },
        "reason": { "type": "string" },
        "description": { "type": "string" },
        "verdictImpact": { "type": "string", "enum": ["corroborating", "standalone"] },
        "confidence": { "type": "number" },
        "evidence": { "type": "object" },
        "detectorId": { "type": "string" },
        "detectorIds": {
          "type": "array",
          "items": { "type": "string" }
        },
        "critical": { "type": "boolean" },
        "raw": {}
      }
    },
    "normalizedTestResult": {
      "type": "object",
      "required": ["status", "passed", "severity", "category", "artifactId", "context", "countsAsIndicator", "scoreContribution", "value", "description"],
      "properties": {
        "status": { "type": "string", "enum": ["passed", "finding", "inconclusive", "not-applicable"] },
        "passed": { "type": "boolean" },
        "severity": { "type": "string", "enum": ["none", "info", "weak", "medium", "strong", "hard"] },
        "category": { "type": "string" },
        "artifactId": { "type": "string" },
        "context": { "type": "string" },
        "countsAsIndicator": { "type": "boolean" },
        "scoreContribution": { "type": "number" },
        "value": {},
        "description": { "type": ["string", "null"] },
        "findings": {
          "type": "array",
          "items": { "$ref": "#/definitions/detectionResult" }
        }
      }
    },
    "scoredArtifact": {
      "type": "object",
      "required": ["artifactId", "context", "status", "severity", "category", "scoreContribution", "detectorIds", "findings"],
      "properties": {
        "artifactId": { "type": "string" },
        "context": { "type": "string" },
        "status": { "type": "string", "enum": ["passed", "finding", "inconclusive", "not-applicable"] },
        "severity": { "type": "string" },
        "category": { "type": "string" },
        "scoreContribution": { "type": "number" },
        "verdictImpact": { "type": "string", "enum": ["corroborating", "standalone"] },
        "detectorIds": {
          "type": "array",
          "items": { "type": "string" }
        },
        "findings": {
          "type": "array",
          "items": { "$ref": "#/definitions/detectionResult" }
        }
      }
    },
    "summary": {
      "type": "object",
      "required": [
        "totalTests", "passed", "finding", "inconclusive", "notApplicable",
        "infoFindings", "weakFindings", "mediumFindings", "strongFindings", "hardFindings",
        "score", "verdict", "risk", "confidence", "botDetected", "suspicious", "coverage",
        "criticalChecksTotal", "criticalChecksCompleted", "criticalChecksInconclusive", "criticalChecksNotApplicable",
        "uniqueEvidenceCount", "independentCategoryCount", "verdictRule"
      ],
      "properties": {
        "totalTests": { "type": "integer" },
        "passed": { "type": "integer" },
        "finding": { "type": "integer" },
        "inconclusive": { "type": "integer" },
        "notApplicable": { "type": "integer" },
        "infoFindings": { "type": "integer" },
        "weakFindings": { "type": "integer" },
        "mediumFindings": { "type": "integer" },
        "strongFindings": { "type": "integer" },
        "hardFindings": { "type": "integer" },
        "score": { "type": "number" },
        "verdict": { "type": "string", "enum": ["human", "suspicious", "bot", "unknown"] },
        "risk": { "type": "string", "enum": ["low", "medium", "high", "confirmed"] },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "botDetected": { "type": "boolean" },
        "suspicious": { "type": "boolean" },
        "coverage": { "type": "number" },
        "criticalChecksTotal": { "type": "integer" },
        "criticalChecksCompleted": { "type": "integer" },
        "criticalChecksInconclusive": { "type": "integer" },
        "criticalChecksNotApplicable": { "type": "integer" },
        "uniqueEvidenceCount": { "type": "integer" },
        "independentCategoryCount": { "type": "integer" },
        "verdictRule": { "type": "string" }
      }
    }
  }
}
